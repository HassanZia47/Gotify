@page "/goat"
@rendermode InteractiveServer

@using Goatify.Core.Models
@using Goatify.Core.Enums
@using System.Net.Http.Json
@using MudBlazor
@using MudBlazor.Services

@inject HttpClient Http
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 goat-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">
                Goat Dashboard
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage farm goats with server-side pagination
            </MudText>
        </div>

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">
            Livestock Module
        </MudChip>

    </MudStack>

    <!-- SUMMARY -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5 stat-card" Elevation="0">
                <MudText Color="Color.Secondary">Total Goats</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@totalItems</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5 stat-card" Elevation="0">
                <MudText Color="Color.Success">Owned</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@ownedCount</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5 stat-card" Elevation="0">
                <MudText Color="Color.Warning">Sold</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@soldCount</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5 stat-card" Elevation="0">
                <MudText Color="Color.Error">Dead</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@deadCount</MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>

    <!-- TOOLBAR -->
    <MudPaper Class="pa-4 toolbar-card mb-4" Elevation="0">

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="flex-wrap">

            <!-- SEARCH -->
            <MudTextField @bind-Value="search"
                          Placeholder="Search goats..."
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          OnDebounceIntervalElapsed="Reload"/>

            <!-- FILTER -->
            <MudSelect T="GoatStatus?"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Value="@selectedStatus"
                       ValueChanged="OnStatusChanged"
                       Clearable="true"
                       Style="min-width:200px">

                <MudSelectItem T="GoatStatus?" Value="@((GoatStatus?)null)">All</MudSelectItem>
                <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Owned">Owned</MudSelectItem>
                <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Sold">Sold</MudSelectItem>
                <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Dead">Dead</MudSelectItem>

            </MudSelect>

            <!-- ACTIONS -->
            <MudStack Row="true" Spacing="2" Class="ml-auto">

                <MudButton Href="/goat/add"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">

                    Add Goat
                </MudButton>

                <MudButton Href="/goat/deleted"
                           Color="Color.Secondary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.DeleteSweep">

                    Deleted
                </MudButton>

            </MudStack>

        </MudStack>

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Goat"
                  ServerData="LoadServerData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Striped="true"
                  Loading="@loading"
                  RowsPerPage="@pageSize"
                  RowsPerPageChanged="OnPageSizeChanged"
                  Breakpoint="Breakpoint.Sm">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Gender</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Purchase</MudTh>
                <MudTh>Date</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd><b>#@context.Id</b></MudTd>
                <MudTd>@context.Gender</MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.Status)"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        @context.Status
                    </MudChip>
                </MudTd>

                <MudTd>
                    Rs. @context.PurchasePrice.ToString("N0")
                </MudTd>

                <MudTd>
                    @context.PurchaseDate?.ToString("dd MMM yyyy")
                </MudTd>

                <MudTd Align="Align.Center">

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Info"
                                   OnClick="@(() => Edit(context.Id))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => ConfirmDelete(context.Id))" />

                </MudTd>

            </RowTemplate>

            <LoadingContent>
                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>
            </LoadingContent>

            <NoRecordsContent>
                <MudStack Class="pa-10" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Pets"
                             Size="Size.Large"
                             Color="Color.Secondary" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No goats found
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Start by adding your first goat
                    </MudText>
                </MudStack>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .goat-page {
        background: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card,
    .stat-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

</style>

@code {

    private List<Goat> goats = new();

    private bool loading = false;

    private string search = "";

    private int pageSize = 10;

    private int totalItems;

    private int ownedCount;

    private int soldCount;
    private int deadCount;

    private MudTable<Goat>? table;
    private GoatStatus? selectedStatus;

    // SERVER DATA
    private async Task<TableData<Goat>> LoadServerData(
        TableState state,
        CancellationToken token)
    {
        try
        {
            loading = true;

            var result = await Http.GetFromJsonAsync<PagedResult<Goat>>(
                            $"api/goat/paged?page={state.Page + 1}" +
                            $"&pageSize={state.PageSize}" +
                            $"&search={search}" +
                            $"&status={selectedStatus}",
                            token);

            goats = result?.Items ?? new();

            totalItems = result?.TotalCount ?? 0;

            ownedCount = goats.Count(x => x.Status == GoatStatus.Owned);
            soldCount = goats.Count(x => x.Status == GoatStatus.Sold);
            deadCount = goats.Count(x => x.Status == GoatStatus.Dead);

            return new TableData<Goat>
            {
                Items = goats,
                TotalItems = totalItems
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);

            return new TableData<Goat>
            {
                Items = new List<Goat>(),
                TotalItems = 0
            };
        }
        finally
        {
            loading = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    // RELOAD TABLE
    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    // PAGE SIZE
    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;

        if (table != null)
            await table.ReloadServerData();
    }

    // EDIT
    private void Edit(int id)
    {
        Nav.NavigateTo($"/goat/edit/{id}");
    }

    // DELETE
    private async Task DeleteGoat(int id)
    {
        var response = await Http.DeleteAsync($"api/goat/{id}");

        if (response.IsSuccessStatusCode)
        {
            await Reload();
        }
    }

    // CONFIRM DELETE
    private async Task ConfirmDelete(int id)
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            "Are you sure you want to delete this goat?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: options);

        if (result == true)
        {
            await DeleteGoat(id);
        }
    }

    // STATUS COLOR
    private Color GetStatusColor(GoatStatus status)
    {
        return status switch
        {
            GoatStatus.Owned => Color.Success,
            GoatStatus.Sold => Color.Warning,
            GoatStatus.Dead => Color.Error,
            _ => Color.Default
        };
    }

    private async Task OnStatusChanged(GoatStatus? value)
    {
        selectedStatus = value;

        await Reload();
    }
}