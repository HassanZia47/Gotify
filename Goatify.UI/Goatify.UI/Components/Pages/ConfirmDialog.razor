@using MudBlazor

<MudDialog>
    <DialogContent>

        <MudStack Spacing="2" AlignItems="AlignItems.Center">

            <MudIcon Icon="@Icons.Material.Filled.Warning"
                     Color="Color.Error"
                     Size="Size.Large" />

            <MudText Typo="Typo.h6">
                @Title
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @ContentText
            </MudText>

        </MudStack>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="@Color"
                   Variant="Variant.Filled"
                   OnClick="Confirm">
            @ButtonText
        </MudButton>

    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string ContentText { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Confirm";
    [Parameter] public Color Color { get; set; } = Color.Error;

    void Cancel() => MudDialog.Cancel();

    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}