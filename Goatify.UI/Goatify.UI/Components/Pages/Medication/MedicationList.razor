@page "/medications"
@rendermode InteractiveServer

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 med-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                Medication Inventory
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage medicines, treatments and farm health supplies
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Info" Variant="Variant.Text">
            Health Module
        </MudChip>

    </MudStack>

    <!-- STATS -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Medication" />
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Medications
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>

                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- TOOLBAR -->
    <MudPaper Class="pa-4 toolbar-card mb-4" Elevation="0">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Class="flex-wrap"
                  Spacing="3">

            <!-- LEFT: SEARCH -->
            <div style="flex: 1; min-width: 250px;">
                <MudTextField @bind-Value="search"
                              Placeholder="Search medications..."
                              Variant="Variant.Outlined"
                              Immediate="true"
                              DebounceInterval="400"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              FullWidth="true"
                              OnDebounceIntervalElapsed="Reload"
                              Class="search-box" />
            </div>

            <!-- RIGHT: ACTIONS -->
            <MudStack Row="true"
                      Spacing="2">

                <MudButton Href="/medication/add"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">

                    Add Medication
                </MudButton>

                <MudButton Href="/medication/deleted"
                           Color="Color.Secondary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.DeleteSweep">

                    Deleted
                </MudButton>

            </MudStack>

        </MudStack>

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Medication"
                  ServerData="LoadServerData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Loading="@loading"
                  RowsPerPage="@pageSize"
                  RowsPerPageChanged="OnPageSizeChanged"
                  Breakpoint="Breakpoint.Sm">

            <HeaderContent>

                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Type">
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text">
                        @context.Type
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Center">

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Info"
                                   OnClick="@(()=> Edit(context.Id))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(()=> Delete(context.Id, context.Name))" />

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack Class="pa-10" AlignItems="AlignItems.Center">

                    <MudIcon Icon="@Icons.Material.Filled.Medication"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No medications found
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Start by adding your first medication
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>

            </LoadingContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .med-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card,
    .stat-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

</style>

@code {

    private MudTable<Medication>? table;
    private bool loading;
    private string search = "";
    private int pageSize = 10;
    private int totalItems;

    private async Task<TableData<Medication>> LoadServerData(TableState state, CancellationToken token)
    {
        loading = true;

        var result = await Http.GetFromJsonAsync<PagedResult<Medication>>(
            $"api/medication/paged?page={state.Page + 1}&pageSize={state.PageSize}&search={search}",
            token);

        totalItems = result?.TotalCount ?? 0;
        loading = false;

        await InvokeAsync(StateHasChanged);

        return new TableData<Medication>
        {
            Items = result?.Items ?? new List<Medication>(),
            TotalItems = totalItems
        };
    }

    private async Task Reload()
    {
        await table!.ReloadServerData();
    }

    private void Edit(int id)
    {
        Nav.NavigateTo($"/medication/edit/{id}");
    }

    private async Task Delete(int id, string name)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Delete {name}?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result == true)
        {
            await Http.DeleteAsync($"api/medication/{id}");
            await Reload();
        }
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        await table!.ReloadServerData();
    }
}