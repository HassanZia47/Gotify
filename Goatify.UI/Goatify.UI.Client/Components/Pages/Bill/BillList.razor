@page "/bill"

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor
@using MudBlazor.Services

@inject HttpClient Http
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 bill-page">

    <!-- PAGE HEADER -->

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">
                Bill Management
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage bills, payment records, and expenses
            </MudText>
        </div>

        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Href="bill/add"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   Class="rounded-pill px-6">
            Add Bill
        </MudButton>

    </MudStack>

    <!-- STATS -->

    <MudGrid Spacing="3" Class="mb-5">

        <MudItem xs="12" sm="6" md="4" lg="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2">

                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                    </MudAvatar>

                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Bills
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>
                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- TOOLBAR -->

    <MudPaper Class="pa-4 mb-4 toolbar-card" Elevation="0">

        <MudGrid AlignItems="AlignItems.Center" Spacing="2">

            <MudItem xs="12" md="6">

                <MudTextField @bind-Value="search"
                              Placeholder="Search by bill name..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              DebounceInterval="400"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              FullWidth="true"
                              OnDebounceIntervalElapsed="Reload" />

            </MudItem>

            <MudItem xs="12" md="6">

                <MudStack Row="true"
                          Justify="Justify.FlexEnd"
                          Spacing="2"
                          Class="flex-wrap">

                    <MudButton Href="bill/deleted"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                               Color="Color.Error">

                        Deleted Bills

                    </MudButton>

                </MudStack>

            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- TABLE -->

    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Bill"
                  ServerData="LoadServerData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Striped="false"
                  Bordered="false"
                  Loading="@loading"
                  Breakpoint="Breakpoint.Sm"
                  RowsPerPage="@pageSize"
                  RowsPerPageChanged="OnPageSizeChanged"
                  Class="modern-table">

            <HeaderContent>

                <MudTh>Name</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Bill Date</MudTh>
                <MudTh>Notes</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Name">

                    <MudStack Spacing="0">

                        <MudText Typo="Typo.body1" Class="fw-semibold">
                            @context.Name
                        </MudText>

                    </MudStack>

                </MudTd>

                <MudTd DataLabel="Amount">

                    <MudChip T="string" Color="Color.Success"
                             Variant="Variant.Text"
                             Size="Size.Small">

                        Rs. @context.Amount.ToString("0.00")

                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Bill Date">

                    <MudText Typo="Typo.body2">

                        @context.BillDate?.ToString("dd MMM yyyy")

                    </MudText>

                </MudTd>

                <MudTd DataLabel="Notes">

                    <MudText Typo="Typo.body2"
                             Class="text-truncate"
                             Style="max-width:220px;">

                        @(string.IsNullOrWhiteSpace(context.Notes)
                            ? "-"
                            : context.Notes)

                    </MudText>

                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Center">

                    <MudStack Row="true"
                              Spacing="1"
                              Justify="Justify.Center">

                        <MudTooltip Text="Edit Bill">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Variant="Variant.Text"
                                           Size="Size.Medium"
                                           OnClick="@(()=> Edit(context.Id))" />

                        </MudTooltip>

                        <MudTooltip Text="Delete Bill">

                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Variant="Variant.Text"
                                           Size="Size.Medium"
                                           OnClick="@(()=> ConfirmDelete(context.Id, context.Name))" />

                        </MudTooltip>

                    </MudStack>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack AlignItems="AlignItems.Center"
                          Justify="Justify.Center"
                          Class="pa-10">

                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-3">
                        No bills found
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Try changing search filters or add a new bill
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="50px" />
                    <MudSkeleton Height="50px" />
                    <MudSkeleton Height="50px" />
                </MudStack>

            </LoadingContent>

            <PagerContent>

                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50 }" />

            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .bill-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .stat-card {
        border-radius: 20px;
        background: white;
        border: 1px solid #eef2f7;
        transition: all .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .toolbar-card {
        border-radius: 20px;
        background: white;
        border: 1px solid #eef2f7;
    }

    .table-card {
        border-radius: 24px;
        overflow: hidden;
        background: white;
        border: 1px solid #eef2f7;
    }

    .modern-table .mud-table-head {
        background-color: #f8fafc;
    }

    .modern-table .mud-table-head th {
        font-weight: 600;
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .modern-table .mud-table-body tr {
        transition: background-color .15s ease;
    }

    .modern-table .mud-table-body tr:hover {
        background-color: #f8fafc;
    }

    .rounded-pill {
        border-radius: 999px !important;
    }

</style>

@code {

    private bool loading = false;
    private string search = "";
    private int pageSize = 10;
    private int totalItems;

    private MudTable<Bill>? table;

    private async Task<TableData<Bill>> LoadServerData(TableState state, CancellationToken token)
    {
        loading = true;

        var result = await Http.GetFromJsonAsync<PagedResult<Bill>>(
            $"api/bill/paged?page={state.Page + 1}&pageSize={state.PageSize}&search={search}",
            token);

        totalItems = result?.TotalCount ?? 0;

        loading = false;

        await InvokeAsync(StateHasChanged);

        return new TableData<Bill>
        {
            Items = result?.Items ?? new List<Bill>(),
            TotalItems = totalItems
        };
    }

    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private void Edit(int id)
    {
        Nav.NavigateTo($"bill/edit/{id}");
    }

    private async Task Delete(int id)
    {
        var response = await Http.DeleteAsync($"api/bill/{id}");

        if (response.IsSuccessStatusCode)
            await Reload();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        await table!.ReloadServerData();
    }

    private async Task ConfirmDelete(int id, string name)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Delete Bill",
            $"Are you sure you want to delete \"{name}\"?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (result == true)
            await Delete(id);
    }

}