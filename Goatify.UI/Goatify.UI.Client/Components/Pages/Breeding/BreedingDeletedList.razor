@page "/breeding/deleted"

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 deleted-breeding-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                Deleted Breeding Records
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Restore deleted breeding cycles and track recovery history
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Error" Variant="Variant.Text">
            Trash Bin
        </MudChip>

    </MudStack>

    <!-- SUMMARY -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudAvatar Color="Color.Error" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" />
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Deleted
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>

                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- SEARCH BAR -->
    <MudPaper Class="pa-4 mb-4 toolbar-card" Elevation="0">

        <MudTextField @bind-Value="search"
                      Placeholder="Search deleted breeding..."
                      Variant="Variant.Outlined"
                      Immediate="true"
                      DebounceInterval="400"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      FullWidth=true
                      OnDebounceIntervalElapsed="Reload" />

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Breeding"
                  ServerData="LoadData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Loading="@loading"
                  Breakpoint="Breakpoint.Sm"
                  Class="modern-table">

            <HeaderContent>

                <MudTh>Male Goat</MudTh>
                <MudTh>Female Goat</MudTh>
                <MudTh>Deleted Date</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Male Goat">

                    <MudChip T="int" Color="Color.Primary"
                             Variant="Variant.Text"
                             Size="Size.Small">

                        #@context.MaleGoatId

                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Female Goat">

                    <MudChip T="int" Color="Color.Info"
                             Variant="Variant.Text"
                             Size="Size.Small">

                        #@context.FemaleGoatId

                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Deleted Date">

                    @context.DeletedDateTime?.ToString("dd MMM yyyy")

                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Center">

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(()=>Restore(context.Id))">

                        Restore

                    </MudButton>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack Class="pa-10" AlignItems="AlignItems.Center">

                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No deleted records
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Everything is clean ??
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>

            </LoadingContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .deleted-breeding-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

    .modern-table .mud-table-head th {
        font-weight: 600;
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .modern-table .mud-table-body tr:hover {
        background-color: #f8fafc;
    }

</style>

@code {

    private MudTable<Breeding>? table;
    private string search = "";
    private bool loading;
    private int totalItems;

    private async Task<TableData<Breeding>> LoadData(TableState state, CancellationToken token)
    {
        loading = true;

        var result = await Http.GetFromJsonAsync<PagedResult<Breeding>>(
            $"api/breeding/deleted-paged?page={state.Page + 1}&pageSize={state.PageSize}&search={search}");
        loading = false;

        totalItems = result?.TotalCount ?? 0;

        await InvokeAsync(StateHasChanged);

        return new TableData<Breeding>
        {
            Items = result?.Items ?? new(),
            TotalItems = result?.TotalCount ?? 0
        };
    }

    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Restore(int id)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "Restore",
            "Restore this record?",
            yesText: "Yes",
            cancelText: "No");

        if (ok == true)
        {
            await Http.PostAsync($"api/breeding/restore/{id}", null);
            await Reload();
        }
    }
}