@page "/goat/deleted"

@using Goatify.Core.Enums
@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 deleted-goat-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                🗑 Deleted Goats
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Restore deleted goats anytime
            </MudText>

        </div>

        <MudChip T="string"
                 Color="Color.Error"
                 Variant="Variant.Text">
            Recycle Bin
        </MudChip>

    </MudStack>

    <!-- SUMMARY -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudAvatar Color="Color.Error" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" />
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Deleted
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>

                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- SEARCH BAR -->
    <!-- SEARCH BAR -->
    <MudPaper Class="pa-4 toolbar-card mb-4" Elevation="0">

        <MudGrid Spacing="2" AlignItems="AlignItems.Center">

            <!-- SEARCH -->
            <MudItem xs="12" md="8">

                <MudTextField @bind-Value="search"
                              Placeholder="Search deleted goats..."
                              Variant="Variant.Outlined"
                              Immediate="true"
                              DebounceInterval="400"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              FullWidth="true"
                              OnDebounceIntervalElapsed="Reload" />

            </MudItem>

            <!-- STATUS FILTER -->
            <MudItem xs="12" md="4">

                <MudSelect T="GoatStatus?"
                           Label="Status"
                           Variant="Variant.Outlined"
                           Value="@selectedStatus"
                           ValueChanged="OnStatusChanged"
                           Clearable="true"
                           FullWidth="true">

                    <MudSelectItem T="GoatStatus?" Value="@((GoatStatus?)null)">
                        All
                    </MudSelectItem>

                    <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Owned">
                        Owned
                    </MudSelectItem>

                    <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Sold">
                        Sold
                    </MudSelectItem>

                    <MudSelectItem T="GoatStatus?" Value="@GoatStatus.Dead">
                        Dead
                    </MudSelectItem>

                </MudSelect>

            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Goat"
                  ServerData="LoadServerData"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Loading="@loading"
                  @ref="table"
                  RowsPerPage="@pageSize"
                  RowsPerPageChanged="OnPageSizeChanged">

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>

            </LoadingContent>

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Gender</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Purchase</MudTh>
                <MudTh>Deleted On</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>#@context.Id</MudTd>

                <MudTd>@context.Gender</MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.Status.ToString())"
                             Variant="Variant.Text">
                        @context.Status
                    </MudChip>
                </MudTd>

                <MudTd>
                    Rs. @context.PurchasePrice.ToString("N0")
                </MudTd>

                <MudTd>
                    @context.DeletedDateTime?.ToString("dd MMM yyyy")
                </MudTd>

                <MudTd Align="Align.Center">

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(()=> Restore(context.Id))">

                        Restore

                    </MudButton>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack Class="pa-10" AlignItems="AlignItems.Center">

                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No deleted goats
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Everything is clean 🎉
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .deleted-goat-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card,
    .stat-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

</style>

@code {

    private bool loading = false;
    private string search = "";

    private int totalItems;
    private int pageSize = 10;

    private MudTable<Goat>? table;
    private GoatStatus? selectedStatus;

    private async Task<TableData<Goat>> LoadServerData(TableState state, CancellationToken token)
    {
        loading = true;

        var result = await Http.GetFromJsonAsync<PagedResult<Goat>>(
                            $"api/goat/deleted-paged?page={state.Page + 1}" +
                            $"&pageSize={state.PageSize}" +
                            $"&search={search}" +
                            $"&status={selectedStatus}",
                            token);

        loading = false;

        totalItems = result?.TotalCount ?? 0;

        await InvokeAsync(StateHasChanged);

        return new TableData<Goat>
        {
            Items = result?.Items ?? new List<Goat>(),
            TotalItems = totalItems
        };
    }

    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;

        await table!.ReloadServerData();
    }

    private async Task Restore(int id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Restore",
            "Do you want to restore this goat?",
            yesText: "Restore",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            });

        if (result == true)
        {
            var response =
                await Http.PostAsync($"api/goat/restore/{id}", null);

            if (response.IsSuccessStatusCode)
            {
                await Reload();
            }
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Active" => Color.Success,
            "Sold" => Color.Warning,
            "Dead" => Color.Error,
            _ => Color.Default
        };
    }

    private async Task OnStatusChanged(GoatStatus? value)
    {
        selectedStatus = value;

        await Reload();
    }
}