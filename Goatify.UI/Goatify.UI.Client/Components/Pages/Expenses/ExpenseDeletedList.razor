@page "/expense/deleted"
@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 deleted-expense-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                Deleted Expenses
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Restore or permanently review deleted financial records
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Error" Variant="Variant.Text">
            Recycle Bin
        </MudChip>

    </MudStack>

    <!-- SUMMARY -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudAvatar Color="Color.Error" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" />
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Deleted
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>

                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- SEARCH BAR -->
    <MudPaper Class="pa-4 toolbar-card mb-4" Elevation="0">

        <MudTextField @bind-Value="search"
                      Placeholder="Search deleted expenses..."
                      Variant="Variant.Outlined"
                      Immediate="true"
                      DebounceInterval="400"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      FullWidth=true
                      OnDebounceIntervalElapsed="Reload" />

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Expense"
                  ServerData="LoadServerData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Loading="@loading"
                  RowsPerPage="@pageSize"
                  RowsPerPageChanged="OnPageSizeChanged"
                  Breakpoint="Breakpoint.Sm">

            <HeaderContent>

                <MudTh>Name</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Deleted Date</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Amount">

                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text">
                        Rs. @context.TotalPrice.ToString("0.00")
                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Deleted Date">
                    @context.DeletedDateTime?.ToString("dd MMM yyyy")
                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Center">

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(()=> Restore(context.Id))">

                        Restore

                    </MudButton>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack Class="pa-10" AlignItems="AlignItems.Center">

                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No deleted expenses
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Everything is clean 🎉
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>

            </LoadingContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .deleted-expense-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card,
    .stat-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

</style>

@code {

    private int totalItems;
    private bool loading = false;
    private string search = "";
    private MudTable<Expense>? table;
    private int pageSize = 10;

    private async Task<TableData<Expense>> LoadServerData(TableState state, CancellationToken token)
    {
        loading = true;

        var result = await Http.GetFromJsonAsync<PagedResult<Expense>>(
            $"api/expense/deleted-paged?page={state.Page + 1}&pageSize={state.PageSize}&search={search}",
            token);

        loading = false;
        totalItems = result?.TotalCount ?? 0;

        await InvokeAsync(StateHasChanged); // ?? THIS IS THE FIX

        return new TableData<Expense>
        {
            Items = result?.Items ?? new List<Expense>(),
            TotalItems = result?.TotalCount ?? 0
        };
    }

    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        await table!.ReloadServerData();
    }

    private async Task Restore(int id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Restore",
            "Do you want to restore this expense?",
            yesText: "Restore",
            cancelText: "Cancel");

        if (result == true)
        {
            var response = await Http.PostAsync($"api/expense/restore/{id}", null);

            if (response.IsSuccessStatusCode)
                await Reload();
        }
    }
}