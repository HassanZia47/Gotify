@page "/expense/add"
@page "/expense/edit/{Id:int}"

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6 bill-form-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                @(Id.HasValue ? "Edit Expense" : "Create Expense")
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Track farm expenses with accurate cost breakdown
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">
            Finance Module
        </MudChip>

    </MudStack>

    <MudGrid Spacing="4">

        <!-- LEFT FORM -->
        <MudItem xs="12" md="8">

            <MudPaper Class="pa-6 form-card" Elevation="0">

                <MudForm @ref="form">

                    <!-- SECTION: BASIC -->
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">

                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" />
                        </MudAvatar>

                        <MudText Typo="Typo.h6">Basic Information</MudText>

                    </MudStack>

                    <MudTextField T="string"
                                  @bind-Value="expense.Name"
                                  Label="Expense Name"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Name is required"
                                  FullWidth
                                  Class="mb-4" />

                    <MudDatePicker @bind-Date="expense.Date"
                                   Label="Expense Date"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   FullWidth
                                   Class="mb-4" />

                    <MudDivider Class="my-5" />

                    <!-- SECTION: FINANCIAL -->
                    <MudText Typo="Typo.h6" Class="mb-3">
                        Financial Details
                    </MudText>

                    <MudGrid Spacing="3">

                        <MudItem xs="12" md="6">

                            <MudNumericField T="decimal"
                                             @bind-Value="expense.Quantity"
                                             Label="Quantity"
                                             Variant="Variant.Outlined"
                                             Required="true"
                                             FullWidth
                                             Validation="@( (decimal v) => v <= 0 ? "Must be greater than 0" : null )" />

                        </MudItem>

                        <MudItem xs="12" md="6">

                            <MudTextField T="string"
                                          @bind-Value="expense.Unit"
                                          Label="Unit (kg, bags, etc)"
                                          Variant="Variant.Outlined"
                                          FullWidth />

                        </MudItem>

                        <MudItem xs="12">

                            <MudNumericField T="decimal"
                                             @bind-Value="expense.PricePerUnit"
                                             Label="Price Per Unit"
                                             Variant="Variant.Outlined"
                                             Required="true"
                                             FullWidth
                                             Validation="@( (decimal v) => v <= 0 ? "Must be greater than 0" : null )" />

                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-5" />

                    <!-- NOTES -->
                    <MudText Typo="Typo.h6" Class="mb-3">
                        Notes
                    </MudText>

                    <MudTextField T="string"
                                  @bind-Value="expense.Notes"
                                  Lines="4"
                                  Variant="Variant.Outlined"
                                  Placeholder="Optional notes..."
                                  FullWidth />

                </MudForm>

            </MudPaper>

        </MudItem>

        <!-- RIGHT PANEL -->
        <MudItem xs="12" md="4">

            <!-- SUMMARY -->
            <MudPaper Class="pa-5 summary-card mb-4" Elevation="0">

                <MudText Typo="Typo.h6" Class="fw-bold mb-3">
                    Live Summary
                </MudText>

                <MudDivider Class="mb-3" />

                <MudStack Spacing="2">

                    <MudPaper Class="pa-3 info-box" Elevation="0">

                        <MudText Typo="Typo.body2">Quantity</MudText>
                        <MudText Typo="Typo.body1" Class="fw-semibold">
                            @expense.Quantity
                        </MudText>

                    </MudPaper>

                    <MudPaper Class="pa-3 info-box" Elevation="0">

                        <MudText Typo="Typo.body2">Price Per Unit</MudText>
                        <MudText Typo="Typo.body1" Class="fw-semibold">
                            Rs. @expense.PricePerUnit
                        </MudText>

                    </MudPaper>

                    <MudPaper Class="pa-3 info-box" Elevation="0">

                        <MudText Typo="Typo.body2">Total</MudText>

                        <MudChip T="string" Color="Color.Success" Variant="Variant.Text">
                            Rs. @((expense.Quantity * expense.PricePerUnit).ToString("0.00"))
                        </MudChip>

                    </MudPaper>

                </MudStack>

            </MudPaper>

            <!-- ACTIONS -->
            <MudPaper Class="pa-5 action-card" Elevation="0">

                <MudButton FullWidth
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Save"
                           Disabled="@isSaving"
                           StartIcon="@Icons.Material.Filled.Save">

                    @(isSaving ? "Saving..." : "Save Expense")

                </MudButton>

                <MudButton FullWidth
                           Class="mt-3"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(()=> Nav.NavigateTo("/expenses"))">

                    Cancel

                </MudButton>

            </MudPaper>

        </MudItem>

    </MudGrid>

</MudContainer>

<style>

    .expense-form-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .form-card,
    .summary-card,
    .action-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .info-box {
        background-color: #f8fafc;
        border-radius: 16px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

    .fw-semibold {
        font-weight: 600;
    }

</style>

@code {

    [Parameter]
    public int? Id { get; set; }
    private bool isSaving = false;

    private MudForm form;

    private Expense expense = new()
    {
        Date = DateTime.Now
    };

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            expense =
                await Http.GetFromJsonAsync<Expense>($"api/expense/{Id}")
                ?? new Expense();
        }
    }

    private async Task Save()
    {
        await form.Validate();

        if (!form.IsValid)
            return;

        try
        {
            isSaving = true;

            HttpResponseMessage response;

            if (Id.HasValue)
                response = await Http.PutAsJsonAsync($"api/expense/{Id}", expense);
            else
                response = await Http.PostAsJsonAsync("api/expense", expense);

            if (response.IsSuccessStatusCode)
                Nav.NavigateTo("/expenses");
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine(error);
            }
        }
        finally
        {
            isSaving = false;
        }
    }
}