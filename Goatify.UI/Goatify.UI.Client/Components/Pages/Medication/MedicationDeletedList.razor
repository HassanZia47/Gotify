@page "/medication/deleted"

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 deleted-medication-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                Deleted Medications
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Restore deleted medications and track recovery history
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Error" Variant="Variant.Text">
            Trash Bin
        </MudChip>

    </MudStack>

    <!-- SUMMARY -->
    <MudGrid Class="mb-5" Spacing="3">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 stat-card" Elevation="0">

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudAvatar Color="Color.Error" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" />
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Total Deleted
                        </MudText>

                        <MudText Typo="Typo.h5" Class="fw-bold">
                            @totalItems
                        </MudText>

                    </div>

                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

    <!-- SEARCH BAR -->
    <MudPaper Class="pa-4 mb-4 toolbar-card" Elevation="0">

        <MudTextField @bind-Value="search"
                      Placeholder="Search deleted medications..."
                      Variant="Variant.Outlined"
                      Immediate="true"
                      DebounceInterval="400"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      FullWidth="true"
                      OnDebounceIntervalElapsed="Reload" />

    </MudPaper>

    <!-- TABLE -->
    <MudPaper Class="table-card" Elevation="0">

        <MudTable T="Medication"
                  ServerData="LoadServerData"
                  @ref="table"
                  Hover="true"
                  Dense="false"
                  Loading="@loading"
                  Breakpoint="Breakpoint.Sm"
                  Class="modern-table">

            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Deleted Date</MudTh>
                <MudTh Align="Align.Center">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Type">@context.Type</MudTd>

                <MudTd DataLabel="Deleted Date">
                    @context.DeletedDateTime?.ToString("dd MMM yyyy")
                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Center">

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(()=> Restore(context.Id))">

                        Restore

                    </MudButton>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudStack Class="pa-10" AlignItems="AlignItems.Center">

                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep"
                             Size="Size.Large"
                             Color="Color.Warning" />

                    <MudText Typo="Typo.h6" Class="mt-2">
                        No deleted medications
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Everything is clean ??
                    </MudText>

                </MudStack>

            </NoRecordsContent>

            <LoadingContent>

                <MudStack Class="pa-6">
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                    <MudSkeleton Height="45px" />
                </MudStack>

            </LoadingContent>

        </MudTable>

    </MudPaper>

</MudContainer>

<style>

    .deleted-medication-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .toolbar-card,
    .table-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

    .modern-table .mud-table-head th {
        font-weight: 600;
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .modern-table .mud-table-body tr:hover {
        background-color: #f8fafc;
    }

</style>

@code {

    private MudTable<Medication>? table;

    private bool loading;
    private string search = "";
    private int pageSize = 10;
    private int totalItems;

    private async Task<TableData<Medication>> LoadServerData(TableState state, CancellationToken token)
    {
        try
        {
            loading = true;

            var result = await Http.GetFromJsonAsync<PagedResult<Medication>>(
                $"api/medication/deleted-paged?page={state.Page + 1}&pageSize={state.PageSize}&search={search}",
                token);

            totalItems = result?.TotalCount ?? 0;

            return new TableData<Medication>
            {
                Items = result?.Items ?? new List<Medication>(),
                TotalItems = totalItems
            };
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Reload()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;

        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Restore(int id)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Restore",
            "Do you want to restore this medication?",
            yesText: "Restore",
            cancelText: "Cancel");

        if (result == true)
        {
            var response = await Http.PostAsync($"api/medication/restore/{id}", null);

            if (response.IsSuccessStatusCode)
                await Reload();
        }
    }
}
}