@page "/medication/add"
@page "/medication/edit/{Id:int}"

@using Goatify.Core.Models
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6 bill-form-page">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6 flex-wrap">

        <div>

            <MudText Typo="Typo.h4" Class="fw-bold">
                @(Id.HasValue ? "Edit Medication" : "Create Medication")
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage treatment records and goat health tracking
            </MudText>

        </div>

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">
            Health Module
        </MudChip>

    </MudStack>

    <MudGrid Spacing="4">

        <!-- LEFT FORM -->
        <MudItem xs="12" md="8">

            <MudPaper Class="pa-6 form-card" Elevation="0">

                <MudForm @ref="form">

                    <!-- BASIC INFO -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        Basic Information
                    </MudText>

                    <MudTextField T="string"
                                  @bind-Value="medication.Name"
                                  Label="Medication Name"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth=true
                                  Class="mb-4" />

                    <MudTextField T="string"
                                  @bind-Value="medication.Type"
                                  Label="Type (Injection, Syrup, Tablet)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth=true
                                  Class="mb-4" />

                    <MudTextField T="string"
                                  @bind-Value="medication.Notes"
                                  Lines="3"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  FullWidth=true />

                    <MudDivider Class="my-5" />

                    @if (Id.HasValue)
                    {
                        <!-- GOAT LINKING -->
                        <MudText Typo="Typo.h6" Class="mb-3">
                            Link Goats
                        </MudText>

                        <MudAutocomplete T="Goat"
                                         Label="Search Goat"
                                         Value="selectedGoat"
                                         ValueChanged="g => selectedGoat = g"
                                         SearchFunc="SearchGoats"
                                         ToStringFunc="@(g => g == null ? "" : $"#{g.Id} - {g.PurchasePrice} - {g.PurchaseDate?.ToString("dd MMM yyyy")} - {g.Notes}")"
                                         Clearable="true"
                                         Variant="Variant.Outlined"
                                         FullWidth=true
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         OnBlur="AddGoat"
                                         Class="mb-3" />

                        <!-- SELECTED GOATS -->
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">

                            @foreach (var goat in selectedGoats)
                            {
                                <MudChip T="int" Color="Color.Primary"
                                         Variant="Variant.Text"
                                         Closeable="true"
                                         OnClose="@(() => RemoveGoat(goat.Id))">

                                    #@goat.Id

                                </MudChip>
                            }

                        </MudStack>
                    }

                </MudForm>

            </MudPaper>

        </MudItem>

        <!-- RIGHT PANEL -->
        <MudItem xs="12" md="4">

            <!-- SUMMARY -->
            <MudPaper Class="pa-5 summary-card mb-4" Elevation="0">

                <MudText Typo="Typo.h6" Class="fw-bold mb-3">
                    Summary
                </MudText>

                <MudDivider Class="mb-3" />

                <MudStack Spacing="2">

                    <MudText><b>Name:</b> @medication.Name</MudText>
                    <MudText><b>Type:</b> @medication.Type</MudText>

                    <MudChip T="int" Color="Color.Info" Variant="Variant.Text">
                        @selectedGoats.Count Goat(s) linked
                    </MudChip>

                </MudStack>

            </MudPaper>

            <!-- ACTIONS -->
            <MudPaper Class="pa-5 action-card" Elevation="0">

                <MudButton FullWidth=true
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Save"
                           Disabled="@isSaving"
                           StartIcon="@Icons.Material.Filled.Save">

                    @(isSaving ? "Saving..." : "Save Medication")

                </MudButton>

                <MudButton FullWidth=true
                           Class="mt-3"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(()=> Nav.NavigateTo("medications"))">

                    Cancel

                </MudButton>

            </MudPaper>

        </MudItem>

    </MudGrid>

    @if (Id.HasValue)
    {
        <!-- LINKED GOATS TABLE -->
        <MudPaper Class="pa-5 mt-6 table-card" Elevation="0">

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">

                <MudText Typo="Typo.h6">Linked Goats</MudText>

                <MudChip T="int" Color="Color.Primary" Variant="Variant.Text">
                    @linkedTotal Total
                </MudChip>

            </MudStack>

            <MudTextField T="string"
                          @bind-Value="linkedSearch"
                          Placeholder="Search linked goats..."
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          FullWidth=true
                          OnDebounceIntervalElapsed="ReloadLinkedGoats"
                          Class="mb-4" />

            <MudTable T="Goat"
                      ServerData="LoadLinkedGoats"
                      @ref="linkedTable"
                      Hover="true"
                      Dense="true"
                      RowsPerPage="@linkedPageSize"
                      RowsPerPageChanged="OnLinkedPageSizeChanged">

                <HeaderContent>

                    <MudTh>ID</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Price</MudTh>
                    <MudTh>Gender</MudTh>
                    <MudTh>Notes</MudTh>
                    <MudTh Align="Align.Right">Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd>#@context.Id</MudTd>

                    <MudTd>
                        <MudChip T="string" Color="@(context.Status.ToString() == "Owned" ? Color.Success : Color.Error)"
                                 Variant="Variant.Text">
                            @context.Status
                        </MudChip>
                    </MudTd>

                    <MudTd>Rs. @context.PurchasePrice</MudTd>
                    <MudTd>@context.Gender</MudTd>
                    <MudTd>@context.Notes</MudTd>

                    <MudTd Align="Align.Right">

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveLinkedGoat(context.Id))" />

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }
</MudContainer>

<style>

    .med-form-page {
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .form-card,
    .summary-card,
    .action-card,
    .table-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #eef2f7;
    }

    .fw-bold {
        font-weight: 700;
    }

</style>

@code {

    [Parameter] public int? Id { get; set; }

    private MudForm form;
    private bool isSaving;
    private bool isLoading;

    private Medication medication = new();

    private Goat? selectedGoat;
    private List<Goat> selectedGoats = new();

    // PAGED LINKED GOATS
    private List<Goat> linkedGoats = new();
    private int linkedPage = 1;
    private int linkedPageSize = 5;
    private string linkedSearch = "";
    private MudTable<Goat>? linkedTable;

    private int linkedTotal;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue) return;

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            medication =
                await Http.GetFromJsonAsync<Medication>($"api/medication/{Id}")
                ?? new Medication();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Load medication error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // =========================
    // PAGED LINKED GOATS
    // =========================
    private async Task<TableData<Goat>> LoadLinkedGoats(TableState state, CancellationToken token)
    {
        try
        {
            var url =
                $"api/medication/{Id}/goats-paged" +
                $"?page={state.Page + 1}" +
                $"&pageSize={state.PageSize}" +
                $"&search={linkedSearch}";

            var result = await Http.GetFromJsonAsync<PagedResult<Goat>>(url, token);

            linkedTotal = result?.TotalCount ?? 0;

            await InvokeAsync(StateHasChanged); // ?? THIS IS THE FIX

            return new TableData<Goat>
            {
                Items = result?.Items ?? new List<Goat>(),
                TotalItems = linkedTotal
            };
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Linked goats load error: {ex.Message}");

            return new TableData<Goat>
            {
                Items = new List<Goat>(),
                TotalItems = 0
            };
        }
    }

    private async Task ReloadLinked()
    {
        if (linkedTable != null)
            await linkedTable.ReloadServerData();
    }

    // =========================
    // SEARCH GOATS (FIXED)
    // =========================
    private async Task<IEnumerable<Goat>> SearchGoats(string value, CancellationToken token)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value))
                return new List<Goat>();

            var result = await Http.GetFromJsonAsync<PagedResult<Goat>>(
                $"api/goat/paged?page=1&pageSize=10&search={value}",
                token);

            return result?.Items ?? new List<Goat>();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Search error: {ex.Message}");
            return new List<Goat>();
        }
    }

    // =========================
    // ADD GOAT (NO DUPLICATES)
    // =========================
    private void AddGoat()
    {
        try
        {
            if (selectedGoat == null) return;

            if (!selectedGoats.Any(x => x.Id == selectedGoat.Id))
                selectedGoats.Add(selectedGoat);

            selectedGoat = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Add goat error: {ex.Message}");
        }
    }

    private void RemoveGoat(int goatId)
    {
        selectedGoats.RemoveAll(x => x.Id == goatId);
    }

    // =========================
    // REMOVE LINKED GOAT
    // =========================
    private async Task RemoveLinkedGoat(int goatId)
    {
        try
        {
            var goat = linkedTable?.Items?.FirstOrDefault(x => x.Id == goatId);

            var confirm = await DialogService.ShowMessageBoxAsync(
                "Confirm Remove",
                $"Remove Goat #{goatId} from this medication?",
                yesText: "Remove",
                cancelText: "Cancel");

            if (confirm != true)
                return;

            var response = await Http.DeleteAsync(
                $"api/medication/{Id}/goat/{goatId}");

            if (response.IsSuccessStatusCode)
            {
                await ReloadLinked();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Delete failed: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Remove linked goat error: {ex.Message}");
        }
    }

    // =========================
    // SAVE
    // =========================
    private async Task Save()
    {
        try
        {
            await form.Validate();
            if (!form.IsValid) return;

            isSaving = true;

            HttpResponseMessage response;

            if (Id.HasValue)
                response = await Http.PutAsJsonAsync($"api/medication/{Id}", medication);
            else
                response = await Http.PostAsJsonAsync("api/medication", medication);

            if (!response.IsSuccessStatusCode)
                return;

            var saved = await response.Content.ReadFromJsonAsync<Medication>();

            if (saved != null && selectedGoats.Any())
            {
                await Http.PostAsJsonAsync(
                    $"api/medication/{saved.Id}/assign-goats",
                    selectedGoats.Select(x => x.Id).ToList());
            }

            Nav.NavigateTo("medications");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Save error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }



    private async Task ReloadLinkedGoats()
    {
        if (linkedTable != null)
            await linkedTable.ReloadServerData();
    }

    private async Task OnLinkedPageSizeChanged(int size)
    {
        linkedPageSize = size;

        if (linkedTable != null)
            await linkedTable.ReloadServerData();
    }
}